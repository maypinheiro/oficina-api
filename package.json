{
  "name": "oficina-api",
  "version": "0.1.0",
  "description": "API REST para oficina mecanica baseada em DDD.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true jest src/integration --runInBand",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "db:apply-sql": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-migrations.ps1",
    "db:seed": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-seed.ps1",
    "db:seed:ts": "tsx scripts/seed.ts",
    "sonar": "powershell -ExecutionPolicy Bypass -File ./scripts/run-sonar.ps1"
  },
  "keywords": [
    "nodejs",
    "ddd",
    "oficina",
    "fiap"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dd-trace": "^6.15.0",
    "dd-trace": "^6.15.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "hot-shots": "^17.1.0",
    "hot-shots": "^17.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
