generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusOrdemServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  APROVADA
  ORCAMENTO_REJEITADO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
}

enum StatusOrcamento {
  PENDENTE
  APROVADO
  REJEITADO
}

model Cliente {
  id        String    @id @default(uuid())
  nome      String
  cpfCnpj   String    @unique
  email     String
  telefone  String
  veiculos  ClienteVeiculo[]
  ordens    OrdemDeServico[]
  criadoEm  DateTime  @default(now())
  atualizadoEm DateTime @updatedAt
}

model Veiculo {
  id        String   @id @default(uuid())
  placa     String
  marca     String
  modelo    String
  ano       Int
  clientes  ClienteVeiculo[]
  ordens    OrdemDeServico[]
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model ClienteVeiculo {
  id        String   @id @default(uuid())
  clienteId String
  veiculoId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id])
  criadoEm  DateTime @default(now())

  @@unique([clienteId, veiculoId])
}

model OrdemDeServico {
  id                         String              @id @default(uuid())
  numeroOs                   String              @unique
  clienteId                  String
  veiculoId                  String
  descricaoProblemaCliente   String
  problemaIdentificado       String?
  status                     StatusOrdemServico
  dataCriacao                DateTime            @default(now())
  dataFinalizacao            DateTime?
  cliente                    Cliente             @relation(fields: [clienteId], references: [id])
  veiculo                    Veiculo             @relation(fields: [veiculoId], references: [id])
  historico                  HistoricoStatusOS[]
  orcamento                  Orcamento?
  criadoEm                   DateTime            @default(now())
  atualizadoEm               DateTime            @updatedAt
}

model HistoricoStatusOS {
  id              String             @id @default(uuid())
  ordemServicoId String
  status          StatusOrdemServico
  dataHora        DateTime           @default(now())
  ordemServico    OrdemDeServico     @relation(fields: [ordemServicoId], references: [id])
}

model Orcamento {
  id              String          @id @default(uuid())
  ordemServicoId String          @unique
  valorTotal      Decimal         @db.Decimal(10, 2)
  status          StatusOrcamento
  ordemServico    OrdemDeServico @relation(fields: [ordemServicoId], references: [id])
  servicos        OrcamentoServico[]
  pecas           OrcamentoPeca[]
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
}

model Servico {
  id           String   @id @default(uuid())
  nome         String
  preco        Decimal  @db.Decimal(10, 2)
  orcamentos   OrcamentoServico[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Peca {
  id           String   @id @default(uuid())
  nome         String
  preco        Decimal  @db.Decimal(10, 2)
  quantidade   Int
  estoqueMinimo Int     @default(5)
  estoque      Estoque?
  orcamentos   OrcamentoPeca[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Estoque {
  pecaId                String @id
  quantidadeDisponivel  Int
  quantidadeReservada   Int
  peca                  Peca   @relation(fields: [pecaId], references: [id])
  atualizadoEm          DateTime @updatedAt
}

model OrcamentoServico {
  id          String    @id @default(uuid())
  orcamentoId String
  servicoId   String
  valor       Decimal   @db.Decimal(10, 2)
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])
  servico     Servico   @relation(fields: [servicoId], references: [id])
}

model OrcamentoPeca {
  id          String    @id @default(uuid())
  orcamentoId String
  pecaId      String
  quantidade  Int
  valorUnitario Decimal @db.Decimal(10, 2)
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])
  peca        Peca      @relation(fields: [pecaId], references: [id])
}
