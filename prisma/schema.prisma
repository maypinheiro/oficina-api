generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusOrdemServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  APROVADA
  ORCAMENTO_REJEITADO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
}

enum StatusOrcamento {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusCliente {
  ATIVO
  INATIVO
  BLOQUEADO
}

enum StatusSaga {
  INICIADA
  EM_ANDAMENTO
  AGUARDANDO_EVENTO
  COMPENSANDO
  COMPENSADA
  CONCLUIDA
  FALHOU
}

enum StatusOutbox {
  PENDENTE
  PUBLICADA
  FALHOU
}

model Cliente {
  id           String           @id @default(uuid())
  nome         String
  cpfCnpj      String           @unique
  email        String
  telefone     String
  status       StatusCliente    @default(ATIVO)
  veiculos     ClienteVeiculo[]
  ordens       OrdemDeServico[]
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  @@index([status])
}

model Veiculo {
  id           String           @id @default(uuid())
  placa        String
  marca        String
  modelo       String
  ano          Int
  clientes     ClienteVeiculo[]
  ordens       OrdemDeServico[]
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  @@index([placa])
}

model ClienteVeiculo {
  id        String   @id @default(uuid())
  clienteId String
  veiculoId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id])
  criadoEm  DateTime @default(now())

  @@unique([clienteId, veiculoId])
}

model OrdemDeServico {
  id                       String              @id @default(uuid())
  numeroOs                 String              @unique
  clienteId                String
  veiculoId                String
  descricaoProblemaCliente String
  problemaIdentificado     String?
  status                   StatusOrdemServico
  dataCriacao              DateTime            @default(now())
  dataFinalizacao          DateTime?
  cliente                  Cliente             @relation(fields: [clienteId], references: [id])
  veiculo                  Veiculo             @relation(fields: [veiculoId], references: [id])
  historico                HistoricoStatusOS[]
  orcamento                Orcamento?
  criadoEm                 DateTime            @default(now())
  atualizadoEm             DateTime            @updatedAt
  billingQuoteId           String?
  executionId              String?
  paymentId                String?
  saga                     SagaInstancia?

  @@index([status, dataCriacao])
  @@index([clienteId, dataCriacao])
}

model SagaInstancia {
  id               String         @id @default(uuid())
  ordemServicoId   String         @unique
  status           StatusSaga     @default(INICIADA)
  etapaAtual       String
  versao           Int            @default(0)
  correlationId    String         @unique
  deadline         DateTime?
  ultimoErro       String?
  iniciadoEm       DateTime       @default(now())
  atualizadoEm     DateTime       @updatedAt
  finalizadoEm     DateTime?
  ordemServico     OrdemDeServico @relation(fields: [ordemServicoId], references: [id])

  @@index([status, atualizadoEm])
}

model OutboxMensagem {
  id            String       @id @default(uuid())
  aggregateId   String
  tipo          String
  versao        Int          @default(1)
  payload       Json
  correlationId String
  sagaId        String?
  status        StatusOutbox @default(PENDENTE)
  tentativas    Int          @default(0)
  proximaTentativaEm DateTime?
  criadoEm      DateTime     @default(now())
  publicadoEm   DateTime?

  @@index([status, proximaTentativaEm, criadoEm])
  @@index([aggregateId, criadoEm])
}

model InboxMensagem {
  messageId     String   @id
  tipo          String
  correlationId String
  sagaId        String?
  payloadHash   String
  processadoEm  DateTime @default(now())

  @@index([correlationId, processadoEm])
}

model HistoricoStatusOS {
  id             String             @id @default(uuid())
  ordemServicoId String
  status         StatusOrdemServico
  dataHora       DateTime           @default(now())
  ordemServico   OrdemDeServico     @relation(fields: [ordemServicoId], references: [id])

  @@index([ordemServicoId, dataHora])
  @@index([status, dataHora])
}

model Orcamento {
  id             String             @id @default(uuid())
  ordemServicoId String             @unique
  valorTotal     Decimal            @db.Decimal(10, 2)
  status         StatusOrcamento
  ordemServico   OrdemDeServico     @relation(fields: [ordemServicoId], references: [id])
  servicos       OrcamentoServico[]
  pecas          OrcamentoPeca[]
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt
}

model Servico {
  id           String             @id @default(uuid())
  nome         String
  preco        Decimal            @db.Decimal(10, 2)
  orcamentos   OrcamentoServico[]
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  @@index([nome])
}

model Peca {
  id            String          @id @default(uuid())
  nome          String
  preco         Decimal         @db.Decimal(10, 2)
  quantidade    Int
  estoqueMinimo Int             @default(5)
  estoque       Estoque?
  orcamentos    OrcamentoPeca[]
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt

  @@index([nome])
}

model Estoque {
  pecaId               String   @id
  quantidadeDisponivel Int
  quantidadeReservada  Int
  peca                 Peca     @relation(fields: [pecaId], references: [id])
  atualizadoEm         DateTime @updatedAt
}

model OrcamentoServico {
  id          String    @id @default(uuid())
  orcamentoId String
  servicoId   String
  valor       Decimal   @db.Decimal(10, 2)
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])
  servico     Servico   @relation(fields: [servicoId], references: [id])
}

model OrcamentoPeca {
  id            String    @id @default(uuid())
  orcamentoId   String
  pecaId        String
  quantidade    Int
  valorUnitario Decimal   @db.Decimal(10, 2)
  orcamento     Orcamento @relation(fields: [orcamentoId], references: [id])
  peca          Peca      @relation(fields: [pecaId], references: [id])
}
